#!/usr/bin/python3
"""Execute one explicitly allowed program from a bounded JSON argv request.

No shell or transient root unit is involved: arguments remain literal and the
program inherits the agent's sandbox. Administrators must approve the program's
own argument semantics; allowing an interpreter grants that interpreter's power.
"""

import json
import os
import sys

MAX_REQUEST_BYTES = 65536
MAX_ARGUMENTS = 128
MAX_ARGUMENT_BYTES = 4096


def reject(message, code=64):
    print("qubesair.Exec: " + message, file=sys.stderr)
    raise SystemExit(code)


def absolute_program(value):
    return (
        value.startswith("/")
        and not value.startswith("//")
        and os.path.normpath(value) == value
        and ":" not in value
        and not any(ord(c) < 32 or ord(c) == 127 for c in value)
    )


def request_arguments():
    raw = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
    if len(raw) > MAX_REQUEST_BYTES:
        reject("request exceeds 64 KiB")
    try:
        argv = json.loads(raw)
    except (ValueError, UnicodeError, RecursionError):
        reject("expected a JSON array of argument strings")
    if not isinstance(argv, list) or not 1 <= len(argv) <= MAX_ARGUMENTS:
        reject("expected 1 to 128 arguments")
    for value in argv:
        if not isinstance(value, str) or "\x00" in value:
            reject("arguments must be strings without NUL bytes")
        try:
            encoded = value.encode("utf-8")
        except UnicodeError:
            reject("arguments must be valid UTF-8")
        if len(encoded) > MAX_ARGUMENT_BYTES:
            reject("argument exceeds 4096 bytes")
    if not absolute_program(argv[0]):
        reject("program must be a normalized absolute path")
    return argv


def main():
    if len(sys.argv) != 1:
        reject("service arguments are not supported")
    configured = os.environ.get("QUBESAIR_EXEC_ALLOW", "")
    if not configured:
        reject("service disabled: no allowed executables configured", 77)
    allowed = configured.split(":")
    if any(not absolute_program(program) for program in allowed):
        reject("invalid executable allowlist", 77)
    argv = request_arguments()
    if argv[0] not in allowed:
        reject("executable is not allowed", 126)
    # Do not leak bootstrap, identity or service-policy environment variables.
    environment = {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8"}
    try:
        os.execve(argv[0], argv, environment)
    except OSError:
        reject("could not execute allowed program", 126)


if __name__ == "__main__":
    main()
