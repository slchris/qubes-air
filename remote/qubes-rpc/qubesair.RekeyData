#!/bin/bash
# qubesair.RekeyData — move an existing data-disk LUKS container from the legacy
# master-derived key to the qube's own data key (DEK).
# =====================================================================================
# This runs during a data-disk migration. The console opens the container once
# with the derived old key, replaces it with the stored DEK, and verifies the old
# key no longer opens it — after that the master secret is not needed for this
# qube at all. The keys never leave RAM and are never written to disk.
#
# Contract:
#   stdin  : one JSON object {"old":"<base64>","new":"<base64>"}, at most 8192 bytes
#            in total (trailing whitespace included; a NUL byte is refused). Both
#            keys arrive over the agent's verified mTLS channel.
#   stdout : one JSON line {"rekeyed":bool,"old_key_removed":bool,"reason":"...","detail":"..."}.
#            reason is machine-readable ("already", "change_failed", "remove_failed",
#            "no_key", "not_luks", "identity_invalid", "malformed", ...). ALWAYS exit 0 so
#            the invoker returns our stdout instead of swallowing it on a non-zero
#            exit (same reason qubesair.Exec exits 0 — see internal/agent/invoker.go).
#
# Safety:
#   - Never formats and never overwrites: a disk that is not LUKS is refused.
#   - Try luksChangeKey first and verify both keys. The add + remove fallback
#     only removes the old key after proving the new key opens the container.
#     An execution/probe failure leaves completion unconfirmed, not rolled back.
#   - Idempotent: "new opens, old does not" reports success without touching the
#     container, so a retry after a crash or a lost reply is safe.
#   - Keys never appear in argv or on disk: stdin -> shell variable -> process
#     substitution, with the privileged half under systemd-run.
#   - Only the outer half enters the privileged half. The console sends no service
#     argument, so any argument is refused ("bad_argument"); the inner half also
#     requires QUBESAIR_REKEY_INNER=1, which the outer half sets via systemd-run
#     --setenv and which neither the agent nor qrexec lets a caller set. Without
#     this, "qubesair.RekeyData+__rekey" skipped every check below, and old == new
#     removed the only keyslot.
#
# Requires python3, which the agent package already declares for Exec/FileCopy.
# =====================================================================================
set +e
# Byte semantics for read -n and ${#payload} below, whatever locale the caller has.
export LC_ALL=C
# TMOUT is read's default timeout; a timeout must not end the request early.
unset TMOUT

# Only the installed service and the shared root-only identity checker may run.
SELF="/etc/qubes-rpc/qubesair.RekeyData"
MOUNT_CHECK="/usr/lib/qubes-air/data-mount.py"
# Two base64 data keys plus JSON framing fit far below this; the cap exists so a
# hostile caller cannot make the service buffer unbounded input.
MAX_REQUEST_BYTES=8192

emit() {
    printf '{"rekeyed":%s,"old_key_removed":%s,"reason":"%s","detail":"%s"}\n' "$1" "$2" "$3" "$4"
}

# ---- privileged inner half: old and new keys as two lines on stdin ----
if [ "${1:-}" = "__rekey" ] && [ "${QUBESAIR_REKEY_INNER:-}" = "1" ]; then
    IFS= read -r old
    IFS= read -r new

    # Resolve exactly one scsi1 root block device and validate any existing
    # mapper/mount before probing a key or modifying a keyslot. No device/path
    # override is accepted; guest root and the provider remain trusted.
    if ! dev="$(python3 -I "$MOUNT_CHECK" rekey-device)"; then
        emit false false identity_invalid "data device or mount identity could not be verified"
        exit 0
    fi

    if ! cryptsetup isLuks "$dev" >/dev/null 2>&1; then
        emit false false not_luks "data disk is not a LUKS container; refusing to touch it"
        exit 0
    fi

    # --test-passphrase verifies a key without creating a mapping.
    opens_with() {
        local status
        cryptsetup open --test-passphrase --key-file=<(printf %s "$1") "$dev" >/dev/null 2>&1
        status=$?
        # Only exit 2 can denote a rejected passphrase. Device, resource and
        # execution errors cannot prove an old keyslot is absent. Exit the
        # entire inner service so even a negated probe cannot accept them.
        case "$status" in
            0|2) return "$status" ;;
            *) emit false false probe_failed "keyslot verification failed; migration completion is unknown"
               exit 0 ;;
        esac
    }

    if opens_with "$new"; then
        if ! opens_with "$old"; then
            emit true true already "the disk already answers to the new key only"
            exit 0
        fi
        # Both keys work: a previous attempt added the new key but did not get to
        # remove the old one. Remove it now, and only report success once the old
        # key is proven dead.
        if cryptsetup luksRemoveKey --key-file=<(printf %s "$old") "$dev" >/dev/null 2>&1 \
                && ! opens_with "$old"; then
            emit true true "" "legacy keyslot removed"
        else
            emit true false remove_failed "the new key works but the legacy keyslot could not be removed"
        fi
        exit 0
    fi

    if ! opens_with "$old"; then
        emit false false no_key "neither key opens the container"
        exit 0
    fi

    # Only the old key opens the container: replace it atomically.
    if cryptsetup luksChangeKey --key-file=<(printf %s "$old") "$dev" <(printf %s "$new") >/dev/null 2>&1; then
        if opens_with "$new" && ! opens_with "$old"; then
            emit true true "" "rekeyed"
            exit 0
        fi
    fi

    # Fallback: add the new key, prove it opens, only then remove the old one.
    if ! cryptsetup luksAddKey --key-file=<(printf %s "$old") "$dev" <(printf %s "$new") >/dev/null 2>&1 \
            || ! opens_with "$new"; then
        emit false false change_failed "the new key could not be confirmed; migration completion is unknown"
        exit 0
    fi
    if cryptsetup luksRemoveKey --key-file=<(printf %s "$old") "$dev" >/dev/null 2>&1 \
            && ! opens_with "$old"; then
        emit true true "" "rekeyed via add and remove"
    else
        emit true false remove_failed "the new key works but the legacy keyslot could not be removed"
    fi
    exit 0
fi

# ---- outer half: sandboxed. Validate the request, re-exec the inner. ----
if [ "$#" -gt 0 ]; then
    emit false false bad_argument "service arguments are not supported"
    exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
    emit false false no_python "python3 is required to parse the rekey request"
    exit 0
fi

# Read at most MAX_REQUEST_BYTES + 1 raw bytes. Unlike a command substitution, read
# keeps trailing newlines, so they count against the cap. Status 0 means the byte
# limit or a NUL (which no JSON request contains and a shell variable could not
# carry), 1 means end of input; anything else (a timeout, a read error) may have
# left a partial request and is refused.
IFS= read -r -d '' -n $((MAX_REQUEST_BYTES + 1)) payload
read_status=$?
if [ "$read_status" -gt 1 ]; then
    emit false false malformed "could not read the request"
    exit 0
fi
if [ "${#payload}" -gt "$MAX_REQUEST_BYTES" ]; then
    emit false false oversize "request exceeds ${MAX_REQUEST_BYTES} bytes"
    exit 0
fi
if [ "$read_status" -eq 0 ]; then
    emit false false malformed 'request must be a JSON object with old and new base64 string fields'
    exit 0
fi

keys="$(printf '%s' "$payload" | python3 -c '
import json
import re
import sys

def unique_fields(pairs):
    result = dict(pairs)
    if len(result) != len(pairs):
        raise ValueError("duplicate field")
    return result

try:
    request = json.load(sys.stdin, object_pairs_hook=unique_fields)
except Exception:
    sys.exit(1)
if not isinstance(request, dict) or set(request) != {"old", "new"}:
    sys.exit(1)
old = request.get("old")
new = request.get("new")
if not isinstance(old, str) or not isinstance(new, str):
    sys.exit(1)
# Validate complete JSON strings before converting them to two shell lines.
if any(re.fullmatch(r"[A-Za-z0-9+/=_-]{32,128}", key) is None for key in (old, new)):
    sys.exit(2)
print(old)
print(new)
' 2>/dev/null)"
parse_status=$?
if [ "$parse_status" -eq 2 ]; then
    emit false false bad_key "old and new must each be one base64 data key"
    exit 0
fi
if [ "$parse_status" -ne 0 ]; then
    emit false false malformed 'request must be a JSON object with old and new base64 string fields'
    exit 0
fi
old="$(printf '%s\n' "$keys" | sed -n 1p)"
new="$(printf '%s\n' "$keys" | sed -n 2p)"

if [ "$old" = "$new" ]; then
    emit false false same_key "old and new keys are identical; nothing to change"
    exit 0
fi

if command -v systemd-run >/dev/null 2>&1; then
    reply="$(printf '%s\n%s\n' "$old" "$new" | systemd-run --pipe --wait --collect --quiet \
        --setenv=QUBESAIR_REKEY_INNER=1 -- "$SELF" __rekey 2>/dev/null)"
else
    # No systemd (rare): run directly. cryptsetup may hit the sandbox, but a
    # clear failure JSON beats silently doing nothing.
    reply="$(printf '%s\n%s\n' "$old" "$new" | QUBESAIR_REKEY_INNER=1 "$SELF" __rekey)"
fi
runner_status=$?
if [ "$runner_status" -ne 0 ] || [ -z "$reply" ]; then
    emit false false runner_failed "privileged migration completion is unconfirmed; retry to establish keyslot state"
else
    printf '%s\n' "$reply"
fi
exit 0
