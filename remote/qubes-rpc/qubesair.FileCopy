#!/usr/bin/python3
"""Bounded file transfer inside explicitly approved directories.

Every path component is opened without following symlinks. All operations use
the same directory descriptors in the agent's sandbox; no host shell is used.
"""

import hashlib
import os
import secrets
import stat
import sys

MAX_BYTES = 16 * 1024 * 1024
MAX_HEADER = 4096
DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC


def reject(message, code=64):
    print("qubesair.FileCopy: " + message, file=sys.stderr)
    raise SystemExit(code)


def valid_path(path):
    return (
        path.startswith("/")
        and not path.startswith("//")
        and os.path.normpath(path) == path
        and not any(ord(c) < 32 or ord(c) == 127 for c in path)
    )


def read_request():
    header = sys.stdin.buffer.readline(MAX_HEADER + 1)
    if len(header) > MAX_HEADER or not header.endswith(b"\n"):
        reject("missing or oversized request header")
    try:
        op, path = header[:-1].decode("utf-8").split(" ", 1)
    except (ValueError, UnicodeError):
        reject("expected push or pull and an absolute path")
    if op not in ("push", "pull") or not valid_path(path):
        reject("invalid operation or path")
    configured = os.environ.get("QUBESAIR_FILECOPY_ROOTS", "")
    if not configured:
        reject("no allowed directories configured", 77)
    roots = configured.split(":")
    if any(not valid_path(root) or root == "/" for root in roots):
        reject("invalid allowed directory configuration", 77)
    if not any(path.startswith(root + "/") for root in roots):
        reject("path outside allowed directories", 126)
    return op, path


def open_parent(path):
    # Walk from /, including the configured root itself; no component may be
    # swapped for a symlink between validation and use.
    parts = path.split("/")[1:]
    fd = os.open("/", DIR_FLAGS)
    try:
        for part in parts[:-1]:
            child = os.open(part, DIR_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = child
        return fd, parts[-1]
    except BaseException:
        os.close(fd)
        raise


def push(parent, name, path):
    payload = sys.stdin.buffer.read(MAX_BYTES + 1)
    if len(payload) > MAX_BYTES:
        reject("payload exceeds 16 MiB")
    temporary = ".qubes-air-" + secrets.token_hex(16) + ".part"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                 0o600, dir_fd=parent)
    try:
        with os.fdopen(fd, "wb") as output:
            output.write(payload)
            output.flush()
            os.fsync(output.fileno())
        # Replacing a final symlink replaces the link, never its target.
        os.replace(temporary, name, src_dir_fd=parent, dst_dir_fd=parent)
        os.fsync(parent)
    finally:
        try:
            os.unlink(temporary, dir_fd=parent)
        except FileNotFoundError:
            pass
    digest = hashlib.sha256(payload).hexdigest()
    print("OK push {} {} {}".format(len(payload), digest, path))


def pull(parent, name):
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
    with os.fdopen(fd, "rb") as source:
        info = os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_BYTES:
            reject("expected a regular file no larger than 16 MiB")
        payload = source.read(MAX_BYTES + 1)
        if len(payload) > MAX_BYTES:
            reject("file exceeds 16 MiB")
    sys.stdout.buffer.write(payload)


def main():
    if len(sys.argv) != 1:
        reject("service arguments are not supported")
    op, path = read_request()
    parent, name = open_parent(path)
    try:
        if op == "push":
            push(parent, name, path)
        else:
            pull(parent, name)
    finally:
        os.close(parent)


if __name__ == "__main__":
    try:
        main()
    except OSError:
        reject("file operation failed", 126)
