#!/bin/sh
# Fixed local client: validates the request and authenticates the non-root broker.
# The broker owns the desktop session; this wrapper never interprets Exec fields.
if [ ! -x /usr/bin/qubes-air-desktop ]; then
    echo 'desktop session unavailable' >&2
    exit 69
fi
exec /usr/bin/qubes-air-desktop launch "$@" </dev/null
