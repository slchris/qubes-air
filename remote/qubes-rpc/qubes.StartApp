#!/bin/bash
# qubes.StartApp — request one desktop application on the local Xpra display.
# The app id shares the Relay/agent's 128-byte limit with "qubes.StartApp+".
# Invalid input and helper failures are nonzero results with bounded stderr.
# A success acknowledges the helper, not a visible or persistent application.
#
# The existing systemd-run path still delegates outside the agent sandbox.
# Replacing it and the desktop Exec parser belongs to GUI-01; do not treat this
# request/result contract as acceptance of the complete desktop boundary.
set -uo pipefail
export LC_ALL=C

app="${1:-}"
if [ "$#" -ne 1 ] || [ "${#app}" -gt 113 ] ||
    [[ ! "$app" =~ ^[A-Za-z0-9._+-]+$ || "$app" == '.' || "$app" == *..* ]]; then
    echo 'qubes.StartApp: expected one valid app id' >&2
    exit 64
fi

desktop_display="${QUBESAIR_XPRA_DISPLAY:-:100}"
if [[ ! "$desktop_display" =~ ^:[0-9]{1,5}(\.[0-9]{1,2})?$ ]]; then
    echo 'qubes.StartApp: invalid desktop display' >&2
    exit 69
fi

if ! command -v systemd-run >/dev/null 2>&1; then
    echo 'qubes.StartApp: desktop launcher is unavailable' >&2
    exit 69
fi

if ! desktop_entry="$(getent passwd 1000)"; then
    echo 'qubes.StartApp: desktop account is unavailable' >&2
    exit 69
fi
IFS=: read -r desktop_user _ desktop_uid _ _ desktop_home _ <<< "$desktop_entry"
if [[ "$desktop_entry" == *$'\n'* || "$desktop_uid" != 1000 ||
    ! "$desktop_user" =~ ^[A-Za-z_][A-Za-z0-9_-]{0,31}$ ||
    ! "$desktop_home" =~ ^/[A-Za-z0-9/._-]+$ || "$desktop_home" == *..* ]]; then
    echo 'qubes.StartApp: desktop account is unavailable' >&2
    exit 69
fi

# The service accepts no payload. Helper output must not corrupt its single
# acknowledgement or leak unbounded diagnostics through the transport.
if systemd-run --collect --quiet --property=Type=exec \
    --uid="$desktop_user" \
    --setenv=HOME="$desktop_home" \
    --setenv=DISPLAY="$desktop_display" \
    --setenv=XDG_RUNTIME_DIR=/run/user/1000 \
    -- qubes-desktop-run "$app" </dev/null >/dev/null 2>&1; then
    printf "qubes.StartApp: launched '%s' on %s\n" "$app" "$desktop_display"
else
    printf "qubes.StartApp: failed to launch '%s' on %s\n" "$app" "$desktop_display" >&2
    exit 1
fi
