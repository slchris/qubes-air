# Installed but never enabled or started by package hooks. Activation requires
# uid/gid 1000 with NSS home /data/home and the pinned Xpra/PyGObject dependencies.
[Unit]
Description=Qubes Air unprivileged Xpra session and desktop broker
Documentation=file:///usr/share/doc/qubes-air-agent/README.md
BindsTo=data.mount
Requires=qubes-air-desktop-home.service
After=local-fs.target data.mount qubes-air-desktop-home.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=1000
Group=1000
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/python3 -I /usr/lib/qubes-air/xpra-session.py
RuntimeDirectory=qubes-air-desktop-broker qubes-air-desktop
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
PrivateDevices=yes
# GUI applications need the desktop user's home and the same local X server.
# This unit is separate from the unchanged ProtectHome/PrivateTmp agent unit.
PrivateTmp=no
ProtectHome=no
KillMode=control-group
TimeoutStopSec=25
Restart=on-failure
RestartSec=5
TasksMax=256
MemoryMax=2G
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
