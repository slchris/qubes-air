# Agent keys are generated in the guest; cloud-init supplies CA, token and environment.
# Exec/FileCopy inherit this sandbox and never launch a host systemd-run service.
# See docs/security-controls.md for revocation URL, JSON argv and filesystem limits.
[Unit]
Description=Qubes Air RemoteVM agent
Documentation=file:///usr/share/doc/qubes-air-agent/README.md
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

Environment=QUBESAIR_LISTEN=0.0.0.0:8443

Environment=QUBESAIR_ALLOW=qubesair.Ping

EnvironmentFile=/etc/qubes-air/agent.env

ExecStart=/usr/bin/qubes-air-agent \
    --listen "${QUBESAIR_LISTEN}" \
    --remote-name "${QUBESAIR_REMOTE_NAME}" \
    --revocation-url "${QUBESAIR_REVOCATION_URL}" \
    --service-dir /etc/qubes-rpc \
    --allow "${QUBESAIR_ALLOW}" \
    --ca /etc/qubes-air/ca.pem \
    --cert /etc/qubes-air/agent.pem \
    --key /etc/qubes-air/agent-key.pem

Restart=on-failure
RestartSec=5

User=root
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

ProtectSystem=full

ReadWritePaths=/etc/qubes-air

[Install]
WantedBy=multi-user.target
