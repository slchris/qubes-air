# UnlockData performs mounting only after validating the encrypted device.
# This unit tracks that mount and supplies desktop stop ordering. The condition
# forbids pulling in a mount of an unverified mapper during desktop startup.
[Unit]
Description=Qubes Air verified encrypted data mount
# Unlocking needs the networked agent. Do not order this late mount ahead of
# local-fs.target, or an enabled desktop could delay boot waiting for its key.
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target
JobTimeoutSec=5
ConditionPathIsMountPoint=/data

[Mount]
What=/dev/mapper/qubesair-data
Where=/data
Type=ext4
